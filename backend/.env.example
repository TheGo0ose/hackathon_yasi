# Telegram Bot Token (для валидации initData из Mini App)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Статический API-ключ для B2B-дашборда
DASHBOARD_API_KEY=hackathon-secret-key-2026

# Использовать MockScorer вместо реальной модели (true/false)
USE_MOCK_SCORER=true

# Путь к файлу модели (.pkl / .joblib) — используется при USE_MOCK_SCORER=false
MODEL_PATH=app/ml_inference/models/model.pkl

# Порог отсечения по умолчанию
DEFAULT_THRESHOLD=0.5

# CORS origins (через запятую); * = все
CORS_ORIGINS=*
